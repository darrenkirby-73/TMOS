# Supabase project credentials — find these in your Supabase dashboard under
# Project Settings → API. Copy this file to .env.local and fill them in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API key for the coaching agent (server-only — never exposed to the
# browser). Leave blank to run the coach in mock mode: prompts and data
# payloads are still assembled and sessions still logged, but no model is
# called. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
